#--------------------------------------------------------------------
# Salin file ini menjadi .env lalu sesuaikan nilainya.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#--------------------------------------------------------------------

# production untuk dipakai (wajib saat acara). development hanya untuk mengembangkan aplikasi di laptop sendiri:
# menampilkan detail error & debug toolbar ke semua perangkat di jaringan.
CI_ENVIRONMENT = production

# Kosongkan supaya alamat mengikuti yang dibuka di browser (cocok untuk akses dari
# laptop/HP lain lewat WiFi). Isi hanya kalau perlu alamat tetap.
# app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = absensi_rat_kpni
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
